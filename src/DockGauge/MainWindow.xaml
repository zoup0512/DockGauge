<Window x:Class="DockGauge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DockGauge.Controls"
        Title="DockGauge"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="480" Height="72"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 画刷 -->
        <SolidColorBrush x:Key="AccentBlue" Color="#2E6BF0"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="TextDark" Color="#14181D"/>
        <SolidColorBrush x:Key="TextGray" Color="#7B8494"/>
        <SolidColorBrush x:Key="TextSub" Color="#8A94A6"/>

        <!-- 图标按钮 -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF3F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 细进度条 -->
        <Style x:Key="MiniBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Foreground" Value="#2E6BF0"/>
            <Setter Property="Background" Value="#E8ECF1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右键菜单 -->
        <ContextMenu x:Key="RootMenu">
            <MenuItem x:Name="MenuTopmost" Header="置顶显示" IsCheckable="True" IsChecked="True" Click="MenuTopmostClick"/>
            <MenuItem x:Name="MenuAutoStart" Header="开机自启" IsCheckable="True" Click="MenuAutoStartClick"/>
            <Separator/>
            <MenuItem Header="退出" FontWeight="Bold" Click="MenuExitClick"/>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="Root" MouseLeftButtonDown="RootDragMove">

        <!-- ============ 紧凑悬浮条 ============ -->
        <Grid x:Name="CompactRoot" Margin="10">
            <Border Background="White" CornerRadius="26" BorderBrush="#ECEFF4" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#20395C" BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.20"/>
                </Border.Effect>
                <Grid Margin="20,9" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- 磁盘读写 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="{StaticResource AccentBlue}"
                               FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="W" Foreground="{StaticResource AccentGreen}"
                               FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="CDiskRead" Grid.Row="0" Grid.Column="1" Text="0 B/s" Width="84"
                               TextAlignment="Right" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}"/>
                    <TextBlock x:Name="CDiskWrite" Grid.Row="1" Grid.Column="1" Text="0 B/s" Width="84"
                               TextAlignment="Right" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}"/>

                    <!-- 网络上下行 -->
                    <Path Grid.Row="0" Grid.Column="3" Data="M6,10.5 L6,2.5 M2.7,5.6 L6,2.2 L9.3,5.6"
                          Stroke="{StaticResource AccentBlue}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="12" Height="12" Stretch="None" Margin="0,0,5,0"/>
                    <Path Grid.Row="1" Grid.Column="3" Data="M6,1.5 L6,9.5 M2.7,6.4 L6,9.8 L9.3,6.4"
                          Stroke="{StaticResource AccentGreen}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="12" Height="12" Stretch="None" Margin="0,0,5,0"/>
                    <TextBlock x:Name="CNetUp" Grid.Row="0" Grid.Column="4" Text="0 B/s" Width="84"
                               TextAlignment="Right" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                    <TextBlock x:Name="CNetDown" Grid.Row="1" Grid.Column="4" Text="0 B/s" Width="84"
                               TextAlignment="Right" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>

                    <!-- CPU / RAM -->
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="CPU" FontSize="12.5" MinWidth="38"
                               TextAlignment="Right" Foreground="{StaticResource TextGray}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="6" Text="RAM" FontSize="12.5" MinWidth="38"
                               TextAlignment="Right" Foreground="{StaticResource TextGray}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CCpu" Grid.Row="0" Grid.Column="7" Text="0%" Width="38"
                               TextAlignment="Right" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}"/>
                    <TextBlock x:Name="CRam" Grid.Row="1" Grid.Column="7" Text="0%" Width="38"
                               TextAlignment="Right" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}"/>

                    <!-- 展开/收起 -->
                    <Button Grid.Row="0" Grid.Column="8" Grid.RowSpan="2" Style="{StaticResource IconBtn}"
                            Margin="12,0,0,0" VerticalAlignment="Center" Click="ToggleClick" ToolTip="展开面板">
                        <Canvas Width="12" Height="13">
                            <Path Data="M1.8,2 L6,6.2 L10.2,2" Stroke="#3A404A" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M1.8,6.8 L6,11 L10.2,6.8" Stroke="#3A404A" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 展开面板 ============ -->
        <Grid x:Name="ExpandedRoot" Margin="10" Visibility="Collapsed">
            <Border CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EDF3FB" Offset="0"/>
                        <GradientStop Color="#DEE9F5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#20395C" BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶栏 -->
                    <Border Background="White" CornerRadius="14" Height="46" Margin="10,10,10,2" Padding="6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource IconBtn}" Click="SettingsClick" ToolTip="设置">
                                <Canvas Width="18" Height="18">
                                    <Path Data="M2,4.7 L16,4.7 M2,9 L16,9 M2,13.3 L16,13.3" Stroke="#454B54"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="9" Canvas.Top="2.3" Width="4.8" Height="4.8" Fill="White" Stroke="#454B54" StrokeThickness="1.5"/>
                                    <Ellipse Canvas.Left="3.8" Canvas.Top="6.6" Width="4.8" Height="4.8" Fill="White" Stroke="#454B54" StrokeThickness="1.5"/>
                                    <Ellipse Canvas.Left="10.8" Canvas.Top="10.9" Width="4.8" Height="4.8" Fill="White" Stroke="#454B54" StrokeThickness="1.5"/>
                                </Canvas>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Click="ToggleClick" ToolTip="收起">
                                <Canvas Width="12" Height="13">
                                    <Path Data="M1.8,6.2 L6,2 L10.2,6.2" Stroke="#3A404A" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Path Data="M1.8,11 L6,6.8 L10.2,11" Stroke="#3A404A" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Margin="10,8,10,10" VerticalScrollBarVisibility="Hidden">
                        <StackPanel>

                            <!-- 运行状态 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="运行状态" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDark}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DeviceName" FontSize="20" FontWeight="Bold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextDark}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <ctrl:RingGauge x:Name="CpuGauge" Width="78" Height="78" Label="CPU" Margin="0,0,12,0"/>
                                                <ctrl:RingGauge x:Name="MemGauge" Width="78" Height="78" Label="内存"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="0,14,0,2">
                                            <TextBlock Text="本次运行" FontSize="13" Foreground="{StaticResource TextSub}"/>
                                            <TextBlock x:Name="UptimeText" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextDark}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 网络 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="网络" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDark}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M6,10.5 L6,2.5 M2.7,5.6 L6,2.2 L9.3,5.6" Width="12" Height="12"
                                                  Stretch="None" Stroke="{StaticResource AccentBlue}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ENetUp" Text="0 B/s" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBlue}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <Path Data="M6,1.5 L6,9.5 M2.7,6.4 L6,9.8 L9.3,6.4" Width="12" Height="12"
                                                  Stretch="None" Stroke="{StaticResource AccentGreen}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" Margin="16,0,0,0"/>
                                            <TextBlock x:Name="ENetDown" Text="0 B/s" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentGreen}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ctrl:Sparkline x:Name="NetChart" Height="150" Margin="0,14,0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- 存储读写 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="存储读写" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDark}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="R" FontSize="13.5" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBlue}" Margin="0,0,7,0"/>
                                                <TextBlock x:Name="EDiskRead" Text="0 B/s" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextDark}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                <TextBlock Text="W" FontSize="13.5" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentGreen}" Margin="0,0,7,0"/>
                                                <TextBlock x:Name="EDiskWrite" Text="0 B/s" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextDark}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <ctrl:Sparkline x:Name="DiskChart" Height="130" Margin="0,14,0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- 存储空间 -->
                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="存储空间" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDark}"/>
                                    <ItemsControl x:Name="DrivesList" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,13,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="196"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Canvas Width="32" Height="32" VerticalAlignment="Center">
                                                            <Path Data="M12,2 L20.2,6.1 L12,10.2 L3.8,6.1 Z" Fill="#C7D0DA" Canvas.Left="6" Canvas.Top="3"/>
                                                            <Path Data="M3.8,6.1 L12,10.2 L12,20.4 L3.8,16.3 Z" Fill="#99A5B2" Canvas.Left="6" Canvas.Top="3"/>
                                                            <Path Data="M20.2,6.1 L12,10.2 L12,20.4 L20.2,16.3 Z" Fill="#6E7B8A" Canvas.Left="6" Canvas.Top="3"/>
                                                            <Ellipse Canvas.Left="21" Canvas.Top="21" Width="10" Height="10" Fill="#22C55E" Stroke="White" StrokeThickness="1.4"/>
                                                            <Path Data="M23.6,26.1 L25.2,27.7 L28.4,24.3" Stroke="White" StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Canvas>
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium"
                                                                   Foreground="{StaticResource TextDark}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Grid Grid.Column="2" Margin="10,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Usage}" FontSize="12.5" Foreground="#454C56"
                                                                   HorizontalAlignment="Right"/>
                                                        <ProgressBar Grid.Row="1" Style="{StaticResource MiniBar}" Margin="0,7,0,0"
                                                                     Maximum="1" Value="{Binding Percent}"/>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
